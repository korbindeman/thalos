# Rust build output.
/target/

# Generated visual evidence, video frames, and machine-readable diagnostics.
/artifacts/

# Per-user runtime settings written by the game (window mode, UI scale, …).
/user/

# Local build and launcher configuration.
/.cargo/config.toml
/.cargo/config.toml.bak*
/.env.just

# OS, compiler, and language caches.
.DS_Store
rustc-ice-*.txt
**/__pycache__/

# Session-local Claude state stays ignored, but project skills (steer,
# wgsl-bevy, expert-review) and the expert-review agent personas are shared
# infrastructure and are tracked — the cloud review routine reads them from the
# repo, so ignoring them would silently strip every persona.
/.claude/*
!/.claude/skills/
!/.claude/agents/

# Codex session state is local; the checked-in environment definition is not.
/.codex/*
!/.codex/environments/
!/.codex/environments/environment.toml

# MIRA-1 training data and run artifacts. Manifests/configs stay tracked.
/terrain_data/raw/
/terrain_data/processed/
/terrain_data/synthetic/
/terrain_runs/

# Agent scratch: comparison runs are regenerated on demand; durable evidence
# belongs in artifacts/visual/runs/ per docs/visual_testing.md.
tools/agent_scratch/
.claude/
# Baked drainage raster (NTR-X2q) — 50 MB, regenerate with examples/bake_rivers.rs
assets/terrain_packages/thalos_rivers/*.u8
reference/
