// Jet — a twin-turbofan demo with the proportions of a scaled-down narrow-body
// airliner (think "mini A320" / regional jet). The part kit is light-business-
// jet scale: a Ø1.5 m fuselage (Citation/Learjet class), two Ø1.2 m Mistral
// nacelles slung under the wings. Because the nacelles mount on the wings, the
// natural silhouette is an under-wing airliner, not a rear-engined bizjet.
//
// Proportions: fuselage ≈ 12 m long (length/diameter ≈ 8) with a tapered
// tailcone, wingspan ≈ 12.5 m (span ≈ length, like a real airliner). There is
// no flight model yet, so this is a shape + loadout demo, not a flyer.
//
// Fuselage is node-stacked: cockpit → structural fuselage → tailcone adapter.
// The fuselage carries no fuel; kerosene lives in the wet main wings. Wings,
// stabilizers, nacelles, and gear are surface-mounted. KSP symmetry: a mirrored
// pair is two real parts sharing a `symmetry_group` id. `angle` is radians:
// π/2 (≈1.5708) = right, −π/2 = left, 0 = dorsal (top), π (≈3.14159) = belly.
//
// Tip: in the shipyard's View panel, enable "Horizontal layout (aircraft)" to
// see it on its gear instead of standing nose-up like a rocket.
(
    name: "Jet",
    root: 0,
    parts: [
        (catalog_id: "cockpit"),                                            // 0 nose (command)
        (catalog_id: "fuselage_structural", params: Tank(diameter: 1.5, length: 9.0)), // 1 fuselage (structural)
        (catalog_id: "wing_wet", params: Wing(                             // 2 main wing R (wet)
            span: 5.5, root_chord: 2.4, tip_chord: 0.9,
            sweep: 0.44, dihedral: 0.05, thickness: 0.11, incidence: 0.0,
        )),
        (catalog_id: "wing_wet", params: Wing(                             // 3 main wing L (wet)
            span: 5.5, root_chord: 2.4, tip_chord: 0.9,
            sweep: 0.44, dihedral: 0.05, thickness: 0.11, incidence: 0.0,
        )),
        (catalog_id: "wing_std", params: Wing(                             // 4 tailplane R
            span: 2.0, root_chord: 1.2, tip_chord: 0.55,
            sweep: 0.5, dihedral: 0.0, thickness: 0.1, incidence: 0.0,
        )),
        (catalog_id: "wing_std", params: Wing(                             // 5 tailplane L
            span: 2.0, root_chord: 1.2, tip_chord: 0.55,
            sweep: 0.5, dihedral: 0.0, thickness: 0.1, incidence: 0.0,
        )),
        (catalog_id: "wing_std", params: Wing(                             // 6 vertical fin
            span: 1.7, root_chord: 1.4, tip_chord: 0.65,
            sweep: 0.6, dihedral: 0.0, thickness: 0.1, incidence: 0.0,
        )),
        (catalog_id: "mistral_jet"),                                        // 7 nacelle R
        (catalog_id: "mistral_jet"),                                        // 8 nacelle L
        (catalog_id: "gear_nose", params: Gear(strut_length: 1.25, wheel_radius: 0.3)),  // 9 nose gear
        (catalog_id: "gear_main", params: Gear(strut_length: 1.2, wheel_radius: 0.35)),  // 10 main gear (matched: both 1.55 m drop)
        (catalog_id: "adapter_std", params: Adapter(diameter: 1.5, target_diameter: 0.5)), // 11 tailcone
    ],
    connections: [
        (parent: 0, parent_node: "bottom", child: 1,  child_node: "top"), // cockpit → fuselage
        (parent: 1, parent_node: "bottom", child: 11, child_node: "top"), // fuselage → tailcone
    ],
    surface_mounts: [
        (parent: 1, child: 2, station: 0.42, angle:  1.5708, symmetry_group: Some(0)), // main wing R
        (parent: 1, child: 3, station: 0.42, angle: -1.5708, symmetry_group: Some(0)), // main wing L
        (parent: 1, child: 4, station: 0.93, angle:  1.5708, symmetry_group: Some(1)), // tailplane R
        (parent: 1, child: 5, station: 0.93, angle: -1.5708, symmetry_group: Some(1)), // tailplane L
        (parent: 1, child: 6, station: 0.93, angle:  0.0),                             // vertical fin (single)
        (parent: 2, child: 7, kind: WingPylon, station: 0.35, angle: 0.1, symmetry_group: Some(2)), // nacelle R
        (parent: 3, child: 8, kind: WingPylon, station: 0.35, angle: 0.1, symmetry_group: Some(2)), // nacelle L
        (parent: 1, child: 9,  station: 0.08, angle: 3.14159),                         // nose gear (belly)
        (parent: 1, child: 10, station: 0.58, angle: 3.14159),                         // main gear (belly)
    ],
)
