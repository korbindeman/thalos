// Meridian — a fictional small jetliner in the early jet-age idiom (late
// '50s / early '60s): the optimistic first generation of short-haul jets, kin
// to the Comet / Caravelle class. Swept wings, podded engines, a clean
// circular-section pressure tube. Built from the heavy aircraft-part kit: a
// Ø3.5 m parametric fuselage with its own nose, two Ø2.0 m Sirocco engines
// under the wings, and a heavy tricycle gear set. Proportions of a small
// short-haul jet — ≈33 m long, ≈31.5 m span.
//
// The whole body is one **parametric fuselage** (`fuselage_loft`): a stationed
// superellipse loft that owns its nose (rounded radome, slight droop), barrel,
// and upswept tailcone in a single continuous skin — no separate nose-cone pod.
// Command/crew lives in an **inline cockpit** (`cockpit_inline`), an internal
// module surface-mounted near the nose with no body mesh of its own. The
// fuselage is the root; everything else (cockpit, wings, stabilizers, nacelles,
// gear) surface-mounts onto it and rides its skin. The empennage uses the
// `stabilizer` parts (the `Wing` kind's small/dry/zero-incidence preset) —
// twin tailplanes and a single vertical fin. No flight model yet — a shape +
// loadout demo.
//
// `angle` radians: π/2 (≈1.5708) = right, −π/2 = left, 0 = dorsal (top),
// π (≈3.14159) = belly. Enable "Horizontal layout (aircraft)" in the shipyard
// View panel to see it on its gear.
(
    name: "Meridian",
    root: 0,
    parts: [
        (catalog_id: "fuselage_loft", params: Fuselage(                      // 0 fuselage (root, parametric)
            length: 33.0, max_width: 3.5, max_height: 3.5, roundness: 1.0,
            nose_fraction: 0.11, nose_bluntness: 0.85,
            tail_fraction: 0.30, nose_droop: 0.2, tail_upsweep: 0.9, tail_tip_diameter: 1.2,
        )),
        (catalog_id: "cockpit_inline"),                                      // 1 inline flight deck (command)
        (catalog_id: "wing_wet", params: Wing(                             // 2 main wing R (wet)
            span: 14.0, root_chord: 5.0, tip_chord: 1.6,
            sweep: 0.44, dihedral: 0.06, thickness: 0.11, incidence: 0.0,
        )),
        (catalog_id: "wing_wet", params: Wing(                             // 3 main wing L (wet)
            span: 14.0, root_chord: 5.0, tip_chord: 1.6,
            sweep: 0.44, dihedral: 0.06, thickness: 0.11, incidence: 0.0,
        )),
        (catalog_id: "stabilizer", params: Wing(                           // 4 tailplane R
            span: 4.5, root_chord: 2.6, tip_chord: 1.1,
            sweep: 0.5, dihedral: 0.0, thickness: 0.1, incidence: 0.0,
        )),
        (catalog_id: "stabilizer", params: Wing(                           // 5 tailplane L
            span: 4.5, root_chord: 2.6, tip_chord: 1.1,
            sweep: 0.5, dihedral: 0.0, thickness: 0.1, incidence: 0.0,
        )),
        (catalog_id: "stabilizer", params: Wing(                           // 6 vertical fin
            span: 4.0, root_chord: 3.2, tip_chord: 1.4,
            sweep: 0.6, dihedral: 0.0, thickness: 0.1, incidence: 0.0,
        )),
        (catalog_id: "sirocco_turbofan"),                                   // 7 nacelle R
        (catalog_id: "sirocco_turbofan"),                                   // 8 nacelle L
        (catalog_id: "gear_nose_hd", params: Gear(strut_length: 2.0, wheel_radius: 0.5)), // 9 nose gear
        (catalog_id: "gear_main_hd", params: Gear(strut_length: 1.9, wheel_radius: 0.6)), // 10 main gear (matched: both 2.50 m drop)
    ],
    connections: [],
    surface_mounts: [
        (parent: 0, child: 1, station: 0.06, angle: 0.0),                              // inline cockpit (forward dorsal)
        (parent: 0, child: 2, station: 0.45, angle:  1.5708, symmetry_group: Some(0)), // main wing R
        (parent: 0, child: 3, station: 0.45, angle: -1.5708, symmetry_group: Some(0)), // main wing L
        (parent: 0, child: 4, station: 0.90, angle:  1.5708, symmetry_group: Some(1)), // tailplane R (necked tail)
        (parent: 0, child: 5, station: 0.90, angle: -1.5708, symmetry_group: Some(1)), // tailplane L
        (parent: 0, child: 6, station: 0.89, angle:  0.0),                             // vertical fin (single)
        (parent: 2, child: 7, kind: WingPylon, station: 0.33, angle: 0.12, symmetry_group: Some(2)), // nacelle R
        (parent: 3, child: 8, kind: WingPylon, station: 0.33, angle: 0.12, symmetry_group: Some(2)), // nacelle L
        (parent: 0, child: 9,  station: 0.16, angle: 3.14159),                         // nose gear (belly)
        (parent: 0, child: 10, station: 0.57, angle: 3.14159),                         // main gear (belly)
    ],
)
