# Runtime-ready learned terrain is versioned with the repository, but stored
# through Git LFS so ordinary Git history contains only the content-addressed
# pointer. The sidecar's sha256_le_f32 is the same digest as the LFS object id.
assets/terrain_packages/thalos_diffusion/thalos_site_detail_*.f32 filter=lfs diff=lfs merge=lfs -text

# Kòrsou's deterministic runtime terrain grids are reproducible from the
# attributed GeoTIFF/OSM sources, but the checked-in payloads keep the explorer
# runnable after a normal clone without an offline bake.
apps/korsou/assets/terrain/**/*.f32 filter=lfs diff=lfs merge=lfs -text
apps/korsou/assets/terrain/**/*.i16 filter=lfs diff=lfs merge=lfs -text
apps/korsou/assets/terrain/**/*.u8 filter=lfs diff=lfs merge=lfs -text
