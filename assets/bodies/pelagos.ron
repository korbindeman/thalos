#![enable(implicit_some)]
(
    terrain: Ocean((
        seed: 1250,
        cubemap_resolution: 64,
        // Basaltic abyssal sediment. The water column is rendered by
        // `BodyWaterMaterial` (terrain LOD) and the impostor's `shade_water`
        // (orbital), so the bake's seabed must read as ocean floor — not
        // pre-tinted water blue.
        seabed_albedo: (0.04, 0.034, 0.026),
        water_roughness: 0.04,
        sea_level_m: 1.0,
    )),
    ocean: Some((
        wind_axis_body: (0.21, 0.93, 0.31),
        wind_speed_10m_m_s: 11.0,
        significant_wave_height_m: 2.4,
        dominant_wavelength_m: 150.0,
        swell_axis_body: (-0.37, 0.78, 0.50),
        swell_energy: 0.34,
        deep_water_color: (0.012, 0.040, 0.090),
        optical_depth_m: 120.0,
        foam_slope_onset: 0.22,
    )),
    terrestrial_atmosphere: Some((
        // Kármán line at 90 km — slightly deeper than Thalos to match
        // the thicker Rayleigh column (H_R = 9.5 km vs 8 km).
        karman_line_m: 90000.0,
        // Thicker-than-Earth atmosphere — ocean world with deeper
        // Rayleigh column, more saturated blue. τ_v ≈ 2.4× Earth on
        // blue keeps sunsets dramatic without losing the lit-disk
        // identity. Rayleigh H stretched to 9.5 km (warmer surface,
        // more ascent before density falls). Mie τ = 0.04 — clean
        // ocean-air aerosol layer.
        scattering: Some((
            vertical_optical_depth: (0.110, 0.255, 0.620),
            rayleigh_scale_height_m: 9500.0,
            mie_optical_depth: 0.04,
            mie_scale_height_m: 1500.0,
            mie_asymmetry: 0.78,
            strength: 1.0,
        )),
        // Temporarily disabled while the reference cloud layer is being revisited.
        // Previous values: coverage 0.30, albedo (0.78, 0.80, 0.84),
        // scroll_rate 1.5e-5, differential_rotation 0.40.
        clouds: None,
    )),
)
