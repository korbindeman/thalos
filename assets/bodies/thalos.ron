#![enable(implicit_some)]
(
    terrain: Feature((
        seed: 1003,
        body_age_gyr: 5.5,
        // P2A.5 prototype: Thalos now uses a signed ocean-bearing
        // `OceanicTerrestrial` surface. The terrain bake keeps underwater
        // seabed materials (sediment/basalt/shelf), while ocean color and
        // reflection come from the separate water render surface.
        archetype: OceanicTerrestrial,
        composition: IronRichSilicate,
        environment: (
            stellar_flux_earth: 1.0,
            atmosphere: Breathable(pressure_bar: 1.0),
            hydrosphere: OceanFraction(0.62),
            ice_inventory: None,
        ),
        intent: [
            HomeworldIdentity,
            ForgivingLandingTerrain,
        ],
    )),
    terrestrial_atmosphere: Some((
        // Kármán line at 80 km — well above 5 × max(H_R, H_M) = 40 km so
        // the raymarch captures the full column, with a wide transition
        // band for a KSP-style "leaving atmosphere" feel during ascent.
        karman_line_m: 80000.0,
        // Earth-like single-scattering atmosphere. Rayleigh τ_v at sea
        // level matches Bucholtz 1995 (R/G/B ≈ 0.046/0.108/0.264, with
        // β_R · H_R = τ_v and H_R = 8 km). Mie τ_v is the primary
        // distance-haze knob: 0.021 is "clean continental", ~0.06 reads as a
        // hazier, humid-continental day — more aerial perspective on distant
        // terrain. Scale height raised to 1.6 km so the haze climbs the lower
        // slopes of distant relief instead of hugging only the valley floors.
        scattering: Some((
            vertical_optical_depth: (0.046, 0.108, 0.264),
            rayleigh_scale_height_m: 8000.0,
            // Clean-continental Mie. Was 0.06 ("hazier humid day"), which veiled
            // the noon distance into a grey-tan band and washed the ground — Mie
            // is wavelength-independent grey haze, so high values desaturate
            // everything at range. 0.025 keeps crisp distance + a bluer horizon
            // while leaving enough forward-scatter for a sunset glow.
            mie_optical_depth: 0.025,
            // Lowered so the remaining haze hugs the valley floors instead of
            // climbing the visible distance and greying out mid-relief.
            mie_scale_height_m: 1200.0,
            mie_asymmetry: 0.76,
            // Sky in-scatter brightness. The shader's flux units are arbitrary
            // (LIGHT_AT_1AU = 10, SCENE_FLUX_SCALE = 0.5), and at strength 1.0
            // the midday-zenith in-scatter (~0.13) sits below the star-crush
            // threshold (0.20 in `body_sky.wgsl`), so the daytime dome reads as
            // dim navy with stars showing through. Lifted so a clear midday sky
            // reads bright and crushes stars; scales single + multi together so
            // the multiple-scattering horizon-blue balance is preserved, and
            // does not touch extinction (aerial perspective stays put).
            strength: 3.0,
            // Multiple-scattering blue-fill gain. Single scattering reddens the
            // long horizon-grazing path at every sun angle; this lifts the
            // blue-dominant multi-scatter term so the daytime horizon reads
            // pale-blue rather than orange. Tuned live against the runway view.
            multi_scatter_gain: 3.0,
        )),
        // Volumetric cloud layer (Phase 1) — temporarily disabled. Re-enable
        // by swapping `None` for the `Some((...))` below. The terrain
        // `BodySky` pass raymarches a thin slab between `base_altitude_m` and
        // `base_altitude_m + thickness_m`, using the reference coverage cube
        // as the large-scale weather map eroded by 3-D detail noise; the
        // orbital impostor still uses its own fixed reference shell.
        //
        // clouds: Some((
        //     coverage: 0.55,                 // partly cloudy (cube × 2 × coverage, then noise threshold)
        //     albedo: (0.92, 0.94, 0.97),     // bright near-neutral cloud tops
        //     scroll_rate: 2.0e-5,
        //     differential_rotation: 0.40,
        //     base_altitude_m: 1500.0,
        //     thickness_m: 5000.0,
        //     density: 1.0,
        // )),
        clouds: None,
        // Physical atmosphere for aerodynamic forces (drag). Surface pressure
        // is reused from the terrain `atmosphere: Breathable(pressure_bar: 1.0)`
        // above; here we author the thermodynamics. Density ρ0 = P0/(R·T0) and
        // the scale height H = R·T0/g are derived (g from Thalos's own gravity,
        // ~9.06 m/s²), so this is a proper per-body profile, not Earth defaults.
        profile: Some((
            surface_temperature_k: 288.0, // Earth-like (1 bar, flux ≈ 1)
            specific_gas_constant: 287.0, // breathable ≈ dry air
            gamma: 1.4,
        )),
    )),
)
