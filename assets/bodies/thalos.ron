#![enable(implicit_some)]
(
    terrain: Feature((
        seed: 1003,
        body_age_gyr: 5.5,
        // P2A prototype: start Thalos as one all-land, single-biome
        // `GenericTerrestrial` surface. Oceans, polar caps, tectonic
        // silhouettes, hydrology, and biome variety come back in later P2
        // slices after the vertical path is playable.
        archetype: GenericTerrestrial,
        composition: IronRichSilicate,
        environment: (
            stellar_flux_earth: 1.0,
            atmosphere: Breathable(pressure_bar: 1.0),
            hydrosphere: None,
            ice_inventory: None,
        ),
        intent: [
            HomeworldIdentity,
            ForgivingLandingTerrain,
        ],
    )),
    terrestrial_atmosphere: Some((
        // Kármán line at 80 km — well above 5 × max(H_R, H_M) = 40 km so
        // the raymarch captures the full column, with a wide transition
        // band for a KSP-style "leaving atmosphere" feel during ascent.
        karman_line_m: 80000.0,
        // Earth-like single-scattering atmosphere. Rayleigh τ_v at sea
        // level matches Bucholtz 1995 (R/G/B ≈ 0.046/0.108/0.264, with
        // β_R · H_R = τ_v and H_R = 8 km). Mie τ_v is the primary
        // distance-haze knob: 0.021 is "clean continental", ~0.06 reads as a
        // hazier, humid-continental day — more aerial perspective on distant
        // terrain. Scale height raised to 1.6 km so the haze climbs the lower
        // slopes of distant relief instead of hugging only the valley floors.
        scattering: Some((
            vertical_optical_depth: (0.046, 0.108, 0.264),
            rayleigh_scale_height_m: 8000.0,
            mie_optical_depth: 0.06,
            mie_scale_height_m: 1600.0,
            mie_asymmetry: 0.76,
            strength: 1.0,
        )),
        // Volumetric cloud layer (Phase 1) — temporarily disabled. Re-enable
        // by swapping `None` for the `Some((...))` below. The terrain
        // `BodySky` pass raymarches a thin slab between `base_altitude_m` and
        // `base_altitude_m + thickness_m`, using the reference coverage cube
        // as the large-scale weather map eroded by 3-D detail noise; the
        // orbital impostor still uses its own fixed reference shell.
        //
        // clouds: Some((
        //     coverage: 0.55,                 // partly cloudy (cube × 2 × coverage, then noise threshold)
        //     albedo: (0.92, 0.94, 0.97),     // bright near-neutral cloud tops
        //     scroll_rate: 2.0e-5,
        //     differential_rotation: 0.40,
        //     base_altitude_m: 1500.0,
        //     thickness_m: 5000.0,
        //     density: 1.0,
        // )),
        clouds: None,
    )),
)
