#![enable(implicit_some)]
(
    // Mira is the first offline package-backed terrain body (ADR-0008). The
    // package freezes this intent at `assets/terrain_packages/Mira.bin`; the
    // game validates its content key before constructing `BakedSurface`.
    terrain: Feature((
        seed: 1004,
        cubemap_resolution: 512,
        body_age_gyr: 4.5,
        archetype: AirlessImpactMoon,
        composition: SilicateDominated,
        environment: (
            stellar_flux_earth: 1.0,
            atmosphere: None,
            hydrosphere: None,
            ice_inventory: None,
        ),
        intent: [
            ReadAsMoon,
            DistinctNearSideFace,
            DifferentFarSide,
            FirstLandingWorld,
        ],
        projection: AirlessImpact((
            // MVP density: enough explicit structure to read at orbit while
            // keeping package generation iterative on developer hardware.
            base_crater_count: 32000,
            crater_age_bias: 2.6,
            forced_young_count: 8,
            min_crater_radius_m: 650.0,
            max_crater_radius_m: 90000.0,
            cubemap_bake_threshold_m: 1500.0,
            secondary_parent_radius_m: 30000.0,
            secondaries_per_parent: 14,
            mare_fill_fraction: 0.72,
            mare_boundary_noise_amplitude_m: 700.0,
            mare_boundary_noise_freq: 4.0,
            procellarum: (
                fill_level_m: 80.0,
                near_side_half_angle_rad: 1.22,
                mask_threshold: -0.12,
                mask_frequency: 1.15,
                boundary_noise_amplitude_m: 520.0,
            ),
            regolith_bake_d_min_m: 350.0,
            regolith_density_wavelength_m: 250000.0,
            highland_mature_albedo: 0.102,
            highland_fresh_albedo: 0.235,
            mare_mature_albedo: 0.043,
            mare_fresh_albedo: 0.064,
            mare_tint: (0.90, 0.92, 0.97),
        )),
        authored_features: [
            Megabasin((
                id: "mira.near_side_megabasin_a",
                center_dir: (1.0, 0.04, 0.20),
                radius_km: 410.0,
                depth_km: 8.0,
                ring_count: 4,
                lock: Placement,
            )),
            Megabasin((
                id: "mira.near_side_megabasin_b",
                center_dir: (1.0, -0.28, -0.18),
                radius_km: 180.0,
                depth_km: 4.0,
                lock: Placement,
            )),
        ],
    )),

    surface_frame_ceiling_m: 15000.0,
)
