#![enable(implicit_some)]
(
    // Terrain generation is DISABLED for Mira — it renders as a solid-colour
    // placeholder impostor (the `TerrainConfig::None` path in
    // `rendering::spawn::spawn_bodies`), like every body that ships without a
    // per-body terrain block. Omitting the `terrain` field here yields
    // `TerrainConfig::None` after the parse fold in `thalos_world::parsing`.
    //
    // There is no Mira-specific surface generator yet. The old
    // `Feature(AirlessImpactMoon)` block did NOT actually author Mira's ground:
    // the runtime `ProceduralSurface` is keyed only by radius + body id and
    // ignores the `TerrainConfig`, so Mira was sharing Thalos's Earth-like
    // continent/ocean generator ("Earth's terrain"). The Feature block only
    // flipped Mira into the procedural branch. When a real generator lands,
    // re-enable a `terrain:` entry here. Design intent for that day: an airless,
    // heavily-cratered impact moon with a distinct near-side face (mare fill,
    // near-side megabasins, regolith). The full old config is in git history.

    // Navball auto-switches to the Surface velocity mode at/below this altitude
    // (metres above mean radius). Inert while Mira is a placeholder, kept as
    // authored intent for when the surface returns. Omit to fall back to the
    // radius-derived default (~0.5% of radius).
    surface_frame_ceiling_m: 15000.0,
)
