#![enable(implicit_some)]
(
    terrain: Feature((
        seed: 1007,
        body_age_gyr: 4.3,
        archetype: ColdDesertFormerlyWet,
        composition: BasalticSilicate,
        environment: (
            stellar_flux_earth: 0.33,
            atmosphere: ThinCo2(pressure_bar: 0.015),
            hydrosphere: AncientLost,
            ice_inventory: Moderate,
        ),
        intent: [
            ReadAsFirstInterplanetarySurfaceWorld,
            ForgivingLandingTerrain,
            VisibleAncientWaterStory,
            RustDustAndEvaporites,
        ],
        projection: ColdDesert((
            relief_scale_m: 1.0,
            volcanic_dark_strength: 1.0,
            pale_basin_strength: 1.0,
            channel_strength: 1.0,
            dune_strength: 1.0,
            base_crater_count: 90000,
            crater_age_bias: 3.2,
            archive_crater_age_bias: 4.2,
            forced_young_count: 2,
            min_crater_radius_m: 800.0,
            max_crater_radius_m: 90000.0,
            cubemap_bake_threshold_m: 1200.0,
        )),
        ice_caps: [
            (
                edge_latitude_deg: 62.0,
                solid_latitude_deg: 63.4,
                edge_noise_deg: 5.0,
                edge_sharpness: 0.96,
                noise_frequency: 2.8,
                max_thickness_m: 140.0,
                albedo_linear: (0.90, 0.94, 0.96),
                dust_albedo_linear: (0.58, 0.56, 0.50),
                albedo_strength: 0.90,
                roughness: 0.44,
                roughness_strength: 0.90,
            ),
        ],
        authored_features: [
            Megabasin((
                id: "vaelen.impact_basin_archive.southern_pale_megabasin",
                parent: "vaelen.impact_basin_archive",
                center_dir: (-0.28, -0.74, 0.61),
                radius_km: 360.0,
                depth_km: 3.8,
                lock: Placement,
            )),
            Megabasin((
                id: "vaelen.impact_basin_archive.western_dark_basin",
                parent: "vaelen.impact_basin_archive",
                center_dir: (-0.92, -0.10, -0.38),
                radius_km: 245.0,
                depth_km: 3.2,
                lock: Placement,
            )),
            Megabasin((
                id: "vaelen.impact_basin_archive.northeast_buried_basin",
                parent: "vaelen.impact_basin_archive",
                center_dir: (0.66, 0.31, -0.68),
                radius_km: 285.0,
                depth_km: 3.4,
                lock: Placement,
            )),
        ],
    )),
    terrestrial_atmosphere: Some((
        // Kármán line at 60 km — thinner shell than Thalos's 80 km,
        // matching the thinner physical column. Still well above the
        // ~40 km tail of the raymarch contribution.
        karman_line_m: 60000.0,
        // Cold-desert atmosphere — thinner than Thalos's, warm/red
        // tinted. Rayleigh per-channel τ skews strongly red (R = 7×
        // B) so any in-scatter shifts orange/butterscotch instead of
        // Thalos's blue. Mie is leaner than Thalos's Earth-clean
        // baseline (0.015 vs 0.021) and concentrated near the
        // surface (H_M = 1500 m), so the halo reads as a thin warm
        // rim rather than a wide diffuse glow. Strength scaled to
        // 0.7 so the overall column is visibly less than Thalos's.
        scattering: Some((
            vertical_optical_depth: (0.035, 0.013, 0.004),
            rayleigh_scale_height_m: 8000.0,
            mie_optical_depth: 0.015,
            mie_scale_height_m: 1500.0,
            mie_asymmetry: 0.60,
            strength: 0.7,
        )),
        clouds: None,
    )),
)
