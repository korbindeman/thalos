#![enable(implicit_some)]
(
    // Terrain generation is DISABLED for Vaelen — it renders as a solid-colour
    // placeholder impostor (the `TerrainConfig::None` path in
    // `rendering::spawn::spawn_bodies`), like every body that ships without a
    // per-body terrain block. Omitting the `terrain` field here yields
    // `TerrainConfig::None` after the parse fold in `thalos_world::parsing`.
    //
    // There is no Vaelen-specific surface generator yet. The old
    // `Feature(ColdDesertFormerlyWet)` block did NOT actually author Vaelen's
    // ground: the runtime `ProceduralSurface` is keyed only by radius + body id
    // and ignores the `TerrainConfig`, so Vaelen was sharing Thalos's Earth-like
    // continent/ocean generator ("Earth's terrain"). The Feature block only
    // flipped Vaelen into the procedural branch. When a real generator lands,
    // re-enable a `terrain:` entry here. Design intent for that day: a cold,
    // rust-dusted desert world that was once wet — ancient outflow channels,
    // evaporite basins, polar ice caps, buried impact basins. Full old config
    // is in git history.
    //
    // The authored atmosphere below is retained (tuned cold-desert optics) but
    // does NOT render while Vaelen is a placeholder: the ship-view `BodySky`
    // pass only becomes visible once ground-LOD terrain is resident (see
    // `sync_body_render_lod`), and the placeholder map disc draws no rim halo.
    // It lights up again when terrain returns.
    terrestrial_atmosphere: Some((
        // Kármán line at 60 km — thinner shell than Thalos's 80 km,
        // matching the thinner physical column. Still well above the
        // ~40 km tail of the raymarch contribution.
        karman_line_m: 60000.0,
        // Cold-desert atmosphere — thinner than Thalos's, warm/red
        // tinted. Rayleigh per-channel τ skews strongly red (R = 7×
        // B) so any in-scatter shifts orange/butterscotch instead of
        // Thalos's blue. Mie is leaner than Thalos's Earth-clean
        // baseline (0.015 vs 0.021) and concentrated near the
        // surface (H_M = 1500 m), so the halo reads as a thin warm
        // rim rather than a wide diffuse glow. Strength scaled to
        // 0.7 so the overall column is visibly less than Thalos's.
        scattering: Some((
            vertical_optical_depth: (0.035, 0.013, 0.004),
            rayleigh_scale_height_m: 8000.0,
            mie_optical_depth: 0.015,
            mie_scale_height_m: 1500.0,
            mie_asymmetry: 0.60,
            strength: 0.7,
        )),
        clouds: None,
    )),
)
