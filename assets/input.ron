#![enable(implicit_some)]
(
    version: 1,
    game: (
        system: (
            bindings: {
                "escape": [Key(Escape)],
                "screenshot": [Key(F2)],
                "toggle_shipyard": [Key(F3)],
                "toggle_free_cam": [Key(F4)],
            },
        ),
        flight: (
            bindings: {
                "toggle_sas": [Key(KeyT)],
                "throttle_full": [Key(KeyZ)],
                "throttle_cut": [Key(KeyX)],
                // KSP convention: Space stages. Time pause lives on the warp
                // ladder instead — "," (warp_decrease) steps down into pause.
                "stage": [Key(Space)],
                // Parking brake: a latched toggle (KSP-style), engaged at
                // startup so a spawned aircraft holds on the runway. Tap to
                // release and taxi, tap to re-engage. Nosewheel steering reuses
                // the yaw axis (A/D) — no separate binding.
                "parking_brake": [Key(KeyB)],
            },
            axes: {
                "pitch": (positive: [Key(KeyW)], negative: [Key(KeyS)]),
                "yaw": (positive: [Key(KeyD)], negative: [Key(KeyA)]),
                "roll": (positive: [Key(KeyE)], negative: [Key(KeyQ)]),
                "throttle_ramp": (
                    positive: [Key(ShiftLeft), Key(ShiftRight)],
                    negative: [Key(ControlLeft), Key(ControlRight)],
                ),
            },
        ),
        hotas: (
            enabled: true,
            // Thrustmaster T.16000M stick. Bevy's gilrs converter only surfaces
            // a device's STANDARD gamepad axes and drops everything it labels
            // `Unknown` — which on a bare flight stick is the twist and the
            // throttle slider. Thalos works around this by reading raw axes
            // through its own gilrs instance (see crates/input/src/joystick.rs),
            // so HOTAS axes are bound by raw platform CODE, not GamepadAxis.
            //
            // Discover codes for your hardware with:
            //     cargo run -p thalos_input --example gamepad_axes
            // (codes are platform-specific; these are this T.16000M on Windows).
            device: NameContains("T16000M"),
            axes: {
                // Pitch on the stick fore/aft axis. `invert` so pull-back =
                // nose up (MSFS convention; positive attitude.x = nose up).
                // If pitch feels reversed, flip this `invert`.
                "pitch": (code: 65537, invert: true, deadzone: 0.05),
                // Roll on the stick left/right axis.
                "roll": (code: 65536, deadzone: 0.05),
                // Yaw on the stick TWIST — the axis Bevy's gamepad layer drops.
                "yaw": (code: 65538, deadzone: 0.05, invert: true),
                // Base throttle slider -> absolute throttle [0, 1]. The slider
                // position becomes the throttle setting (MSFS-style) and takes
                // over from the keyboard Z/X/Shift/Ctrl ramp. `min`/`max` are
                // the raw axis ends mapped to 0..1; flip `invert` if pushing
                // the slider forward decreases throttle.
                //
                // Note: gilrs only reports an axis after it first moves, so the
                // slider claims the throttle the moment you nudge it (until
                // then the keyboard ramp still works).
                "throttle": (code: 65539, min: -1.0, max: 1.0, invert: true),
            },
        ),
        warp: (
            bindings: {
                "warp_to_maneuver": [Key(KeyG)],
                "warp_increase": [Key(Period)],
                "warp_decrease": [Key(Comma)],
                "warp_reset": [Key(Backslash)],
            },
        ),
        view: (
            bindings: {
                "toggle_view": [Key(KeyM)],
                "toggle_photo_mode": [Key(F1), Key(KeyP)],
                "cycle_ship_camera": [Key(KeyV)],
            },
        ),
        camera: (
            bindings: {
                "primary": [MouseButton(Left)],
                "motion": [MouseMotion],
                "wheel": [MouseWheel],
            },
        ),
        eva: (
            bindings: {
                "toggle_player_controller": [Key(KeyF)],
            },
        ),
        eva_move: (
            bindings: {
                "jump": [Key(Space)],
                "sprint": [Key(ShiftLeft), Key(ShiftRight)],
            },
            axes: {
                "forward": (positive: [Key(KeyW)], negative: [Key(KeyS)]),
                "strafe": (positive: [Key(KeyD)], negative: [Key(KeyA)]),
            },
        ),
        maneuver: (
            bindings: {
                "toggle_place_node": [Key(KeyN)],
                "delete_node": [Key(Delete), Key(Backspace)],
            },
        ),
        maneuver_precision: (
            bindings: {
                "fine": [Key(ShiftLeft), Key(ShiftRight)],
                "ultra": [Key(ControlLeft), Key(ControlRight)],
            },
        ),
    ),
    body_editor: (
        bindings: {
            "primary": [MouseButton(Left)],
            "camera_motion": [MouseMotion],
            "camera_wheel": [MouseWheel],
            "toggle_fullbright": [Key(KeyF)],
            "overlay_suppress": [Key(Space)],
        },
    ),
    shipyard: (
        bindings: {
            "primary": [MouseButton(Left)],
            "camera_motion": [MouseMotion],
            "camera_wheel": [MouseWheel],
            "precision_slow": [Key(ShiftLeft), Key(ShiftRight)],
        },
    ),
)
