#![enable(implicit_some)]
(
    version: 1,
    game: (
        system: (
            bindings: {
                "escape": [Key(Escape)],
                "screenshot": [Key(F2)],
                "toggle_free_cam": [Key(F4)],
            },
        ),
        flight: (
            bindings: {
                "toggle_sas": [Key(KeyT)],
                "throttle_full": [Key(KeyZ)],
                "throttle_cut": [Key(KeyX)],
                // KSP convention: Space stages. Time pause lives on the warp
                // ladder instead — "," (warp_decrease) steps down into pause.
                "stage": [Key(Space)],
                // Parking brake: a latched toggle (KSP-style), engaged at
                // startup so a spawned aircraft holds on the runway. Tap to
                // release and taxi, tap to re-engage. Nosewheel steering reuses
                // the yaw axis (A/D) — no separate binding.
                "parking_brake": [Key(KeyB)],
            },
            axes: {
                "pitch": (positive: [Key(KeyW)], negative: [Key(KeyS)]),
                "yaw": (positive: [Key(KeyD)], negative: [Key(KeyA)]),
                "roll": (positive: [Key(KeyE)], negative: [Key(KeyQ)]),
                "throttle_ramp": (
                    positive: [Key(ShiftLeft), Key(ShiftRight)],
                    negative: [Key(ControlLeft), Key(ControlRight)],
                ),
            },
        ),
        hotas: (
            enabled: false,
            // Example continuous-axis profile. Confirm how Bevy names your
            // hardware axes during local testing, then flip this on and
            // uncomment the axes you need.
            //
            // device: NameContains("T.16000M"),
            // axes: {
            //     "pitch": (axis: LeftStickY, invert: true, deadzone: 0.05),
            //     "roll": (axis: LeftStickX, deadzone: 0.05),
            //     "yaw": (axis: RightZ, deadzone: 0.05),
            //     "throttle": (axis: LeftZ, min: -1.0, max: 1.0),
            // },
        ),
        warp: (
            bindings: {
                "warp_to_maneuver": [Key(KeyG)],
                "warp_increase": [Key(Period)],
                "warp_decrease": [Key(Comma)],
                "warp_reset": [Key(Backslash)],
            },
        ),
        view: (
            bindings: {
                "toggle_view": [Key(KeyM)],
                "toggle_photo_mode": [Key(F1), Key(KeyP)],
                "cycle_ship_camera": [Key(KeyV)],
            },
        ),
        camera: (
            bindings: {
                "primary": [MouseButton(Left)],
                "motion": [MouseMotion],
                "wheel": [MouseWheel],
            },
        ),
        eva: (
            bindings: {
                "toggle_player_controller": [Key(KeyF)],
            },
        ),
        eva_move: (
            bindings: {
                "jump": [Key(Space)],
                "sprint": [Key(ShiftLeft), Key(ShiftRight)],
            },
            axes: {
                "forward": (positive: [Key(KeyW)], negative: [Key(KeyS)]),
                "strafe": (positive: [Key(KeyD)], negative: [Key(KeyA)]),
            },
        ),
        maneuver: (
            bindings: {
                "toggle_place_node": [Key(KeyN)],
                "delete_node": [Key(Delete), Key(Backspace)],
            },
        ),
        maneuver_precision: (
            bindings: {
                "fine": [Key(ShiftLeft), Key(ShiftRight)],
                "ultra": [Key(ControlLeft), Key(ControlRight)],
            },
        ),
    ),
    body_editor: (
        bindings: {
            "primary": [MouseButton(Left)],
            "camera_motion": [MouseMotion],
            "camera_wheel": [MouseWheel],
            "toggle_fullbright": [Key(KeyF)],
            "overlay_suppress": [Key(Space)],
        },
    ),
    shipyard: (
        bindings: {
            "primary": [MouseButton(Left)],
            "camera_motion": [MouseMotion],
            "camera_wheel": [MouseWheel],
            "precision_slow": [Key(ShiftLeft), Key(ShiftRight)],
        },
    ),
)
