// Thalos parts catalog.
//
// Map keys are stable IDs (assigned once, never changed). `display_name`
// is the mutable, user-facing label — rename freely without touching saves.
// Saved ship blueprints reference parts by these IDs.
//
// Parametric parts (decouplers, adapters, tanks) define recipes:
//   - dry_mass scales from `wall_mass_per_m2` × surface area
//   - resource capacity scales from `storage.units_per_m3` × part volume
//
// Reactant ratios are mass fractions and must sum to 1.0 per engine.
// Part `storage` lists are whitelists: a part can only house resources named
// there. Omitted blueprint resources use the catalog defaults; explicit
// blueprint resources are the selected active pools.

(
    parts: {
        "argos": Pod((
            display_name: "Argos",
            diameter: 2.5,
            dry_mass: 2720.0,
            reaction_wheel_torque: 15000.0,
            storage: [
                (resource: Electricity, units: 2.5),
            ],
        )),
        "hyperion": Pod((
            display_name: "Hyperion",
            diameter: 4.0,
            dry_mass: 5800.0,
            reaction_wheel_torque: 40000.0,
            storage: [
                (resource: Electricity, units: 4.0),
            ],
        )),
        // Aircraft cockpit: a nose-cone command pod sized for the plane-scale
        // parts (jet nacelle Ø1.2, landing gear), not the 2.5 m rocket stack.
        // `AircraftCockpit` geometry renders a rounded ogive nose about as long
        // as it is wide (an airliner radome); it's a placeholder silhouette for a
        // real model later. A command pod, but **no reaction wheels**: an
        // aircraft's only attitude authority is its control surfaces, so it
        // handles like a plane (mushy below flying speed, no free torque on the
        // ground), not a spacecraft in plane's clothing.
        "cockpit": Pod((
            display_name: "Canopy Cockpit",
            geometry: AircraftCockpit,
            diameter: 1.5,
            dry_mass: 400.0,
            reaction_wheel_torque: 0.0,
            storage: [
                (resource: Electricity, units: 1.5),
            ],
        )),
        "zephyr": Engine((
            display_name: "Zephyr",
            optimized_for: Atmosphere,
            diameter: 2.5,
            thrust: 500000.0,
            isp: 355.0,
            dry_mass: 450.0,
            reactants: [
                (resource: Methane, mass_fraction: 0.21739131),
                (resource: Lox,     mass_fraction: 0.78260869),
            ],
            power_draw_kw: 0.0,
        )),
        "boreas": Engine((
            display_name: "Boreas",
            optimized_for: Vacuum,
            diameter: 4.0,
            thrust: 1800000.0,
            isp: 380.0,
            dry_mass: 1800.0,
            reactants: [
                (resource: Methane, mass_fraction: 0.21739131),
                (resource: Lox,     mass_fraction: 0.78260869),
            ],
            power_draw_kw: 0.0,
        )),
        "mistral_jet": Engine((
            display_name: "Mistral Jet Nacelle",
            optimized_for: Atmosphere,
            geometry: JetNacelle,
            requires_atmosphere: true,
            intake_requirement: Some((kind: OxygenatedAir, area_m2: 0.45)),
            builtin_intake: Some((kind: OxygenatedAir, area_m2: 0.55, efficiency: 1.0)),
            diameter: 1.2,
            thrust: 120000.0,
            // Effective air-breathing Isp. The current propulsion model still
            // consumes stored fuel only; ambient air is supplied by intake
            // capture rather than stored as a resource.
            isp: 2600.0,
            dry_mass: 680.0,
            reactants: [
                (resource: Kerosene, mass_fraction: 1.0),
            ],
            power_draw_kw: 0.0,
        )),
        "intake_cone": Intake((
            display_name: "Cone Air Intake",
            diameter: 1.25,
            length: 0.9,
            dry_mass: 90.0,
            capture: (kind: OxygenatedAir, area_m2: 0.65, efficiency: 0.95),
        )),
        "decoupler_std": Decoupler((
            display_name: "Decoupler",
            mass_per_diameter: 25.0,
            ejection_impulse_per_diameter: 100.0,
        )),
        "adapter_std": Adapter((
            display_name: "Adapter",
            wall_mass_per_m2: 14.0,
        )),
        "tank_methalox": Tank((
            display_name: "Methalox Tank",
            wall_mass_per_m2: 12.0,
            // 429 L/m³ CH4 + 571 L/m³ LOX → 1000 L/m³ total at stoichiometric
            // O/F ≈ 3.6 mass ratio (Raptor-class). Volume utilization 100%.
            storage: [
                (resource: Methane, units_per_m3: 429.0),
                (resource: Lox,     units_per_m3: 571.0),
            ],
            reactants: [
                (resource: Methane, mass_fraction: 0.21739131),
                (resource: Lox,     mass_fraction: 0.78260869),
            ],
        )),
        "tank_kerosene": Tank((
            display_name: "Kerosene Tank",
            wall_mass_per_m2: 12.0,
            // Near-full volume utilization for a single ambient-density
            // hydrocarbon fuel. Oxidizer is atmospheric for jet engines.
            storage: [
                (resource: Kerosene, units_per_m3: 1000.0),
            ],
            reactants: [
                (resource: Kerosene, mass_fraction: 1.0),
            ],
        )),
        // Structural fuselage: a parametric cylinder that carries no fuel.
        // Same `Tank` recipe and stainless-steel skin as the propellant
        // tanks (so it node-stacks, propagates diameter, and renders
        // identically), but with an empty `storage` whitelist — the body is
        // load-bearing structure, and aircraft fuel lives in the wet wings
        // (`wing_wet`). Empty `reactants` because nothing burns from here.
        "fuselage_structural": Tank((
            display_name: "Fuselage",
            wall_mass_per_m2: 12.0,
            storage: [],
            reactants: [],
        )),
        // Stationed-loft fuselage (`docs/construction.md` §4.2): the advanced
        // airframe body. Same stainless skin and diameter propagation as a
        // structural tank, but a single continuous superellipse loft — barrel +
        // curved, upswept tailcone in one mesh — instead of a cylinder + cone
        // pair. The high-level shape (length, nose/tail fractions, droop,
        // upsweep, tail-tip Ø) is per-instance; `wall_mass_per_m2` scales mass
        // with the lofted skin area. Structure-only for now (empty storage);
        // aircraft fuel still lives in the wet wings.
        //
        // 40 kg/m² is an *airframe* areal density — frames, stringers, floor,
        // pressurization, systems, and interior amortized over the skin — not
        // the bare 12 kg/m² tank-wall skin (which put a 35 m jetliner at a
        // toy-like ~13 t all-up and made it fly like one). This lands the
        // Meridian at ~37 t wet: A220-class wing loading and inertia.
        "fuselage_loft": Fuselage((
            display_name: "Loft Fuselage",
            wall_mass_per_m2: 40.0,
            storage: [],
        )),
        "wing_std": Wing((
            display_name: "Wing",
            // Spar + skin lifting surface: lighter per area than a sealed
            // pressure tank. ~22 kg/m² is a light-alloy airframe ballpark.
            mass_per_m2: 22.0,
        )),
        // Wet wing: the same spar+skin lifting surface as `wing_std`, but its
        // integral wing box is sealed to carry kerosene. Capacity scales with
        // the panel's internal volume (planform × airfoil thickness × wing-box
        // fill; see `wing_volume`), so a bigger wing holds proportionally more
        // fuel. Slightly heavier per area than the dry wing for the tank
        // sealing + plumbing. Used for aircraft main wings; tailplanes and fins
        // stay dry `wing_std`.
        "wing_wet": Wing((
            display_name: "Wet Wing",
            mass_per_m2: 24.0,
            storage: [
                (resource: Kerosene, units_per_m3: 1000.0),
            ],
        )),
        // Stabilizer: the *same* `Wing` part underneath, but armed with the
        // small / dry / zero-incidence empennage preset (`role: Stabilizer`) so
        // it lands as a sane tailplane or fin without hand-tuning. Whether it
        // ends up horizontal (tailplane / canard) or vertical (fin) is decided
        // by where you click — top of the fuselage → vertical, side →
        // horizontal — and twin fins are just this part under Mirror mode.
        // Dry like the standard wing; reuses the same light-alloy mass/area.
        "stabilizer": Wing((
            display_name: "Stabilizer",
            mass_per_m2: 22.0,
            role: Stabilizer,
        )),
        // Landing gear are self-contained "gearbox" footprint parts: one part
        // draws all of its legs in a single mesh (no symmetry). A track > 0
        // means a left/right main pair; track 0 means a single centred nose
        // leg. Mass = legs × (strut_mass_per_m × strut_length + wheel_mass).
        //
        // Light gear set (business-jet class). `gear_main` + `gear_nose` are a
        // matched pair: 1.20 + 0.35 = 1.55 m drop equals the nose's 1.25 + 0.30,
        // so on a common fuselage the aircraft sits level with no hand-tuning.
        "gear_main": Gear((
            display_name: "Main Landing Gear",
            strut_mass_per_m: 60.0,
            wheel_mass: 40.0,
            // Legs at ±0.6 × host radius — a sensible track for a narrow-body
            // belly. Two legs.
            track_fraction: 0.6,
            default_strut_length: 1.2,
            default_wheel_radius: 0.35,
        )),
        "gear_nose": Gear((
            display_name: "Nose Landing Gear",
            strut_mass_per_m: 50.0,
            wheel_mass: 30.0,
            // Single centred leg.
            track_fraction: 0.0,
            default_strut_length: 1.25,
            default_wheel_radius: 0.3,
        )),
        //
        // ---- Heavy class (A220 / narrow-body airliner) -------------------
        // A larger family for a ~Ø3.5 m fuselage. Same kinds as the light
        // parts, scaled up: a wide flight-deck cockpit, a Ø2.0 m geared
        // turbofan, and a heavy gear set (matched 1.90 + 0.60 = 2.50 m drop =
        // nose 2.00 + 0.50).
        // No reaction wheels on aircraft flight decks — see "cockpit".
        "flightdeck": Pod((
            display_name: "Flight Deck",
            geometry: AircraftCockpit,
            diameter: 3.5,
            dry_mass: 2200.0,
            reaction_wheel_torque: 0.0,
            storage: [
                (resource: Electricity, units: 5.0),
            ],
        )),
        // Inline flight deck: an internal command module with no body mesh of
        // its own. It surface-mounts inside a parametric fuselage near the nose
        // (the fuselage's own nose is the visible nose) and supplies command /
        // crew / reaction-wheel capability. A windshield region is morphed into
        // the skin where it sits. The `diameter` is nominal (it drives no
        // geometry); it auto-fits whatever fuselage nose it mounts on.
        // No reaction wheels on aircraft flight decks — see "cockpit".
        "cockpit_inline": Pod((
            display_name: "Inline Flight Deck",
            geometry: Inline,
            diameter: 3.5,
            dry_mass: 2200.0,
            reaction_wheel_torque: 0.0,
            storage: [
                (resource: Electricity, units: 5.0),
            ],
        )),
        // Slim early-jet-age turbojet pod (Comet / 707 / CV-880 idiom): a
        // long, narrow nacelle meant to hang in fours under a swept wing rather
        // than as a pair of fat high-bypass fans. Lower thrust and a smaller Ø
        // each — the classic four-engine look. Same Kerosene + ambient-intake
        // model as the Sirocco.
        "vega_turbojet": Engine((
            display_name: "Vega Turbojet",
            optimized_for: Atmosphere,
            geometry: JetNacelle,
            requires_atmosphere: true,
            intake_requirement: Some((kind: OxygenatedAir, area_m2: 0.7)),
            builtin_intake: Some((kind: OxygenatedAir, area_m2: 0.85, efficiency: 1.0)),
            diameter: 1.15,
            // ~50 kN per pod — a JT8D-class early turbojet. Four on the ~37 t
            // Meridian gives T/W ≈ 0.55 (era-appropriate for a jetliner); the
            // previous 80 kN put it at fighter-class T/W ≈ 1.
            thrust: 50000.0,
            isp: 2600.0,
            dry_mass: 650.0,
            reactants: [
                (resource: Kerosene, mass_fraction: 1.0),
            ],
            power_draw_kw: 0.0,
        )),
        "sirocco_turbofan": Engine((
            display_name: "Sirocco Turbofan",
            optimized_for: Atmosphere,
            geometry: JetNacelle,
            requires_atmosphere: true,
            intake_requirement: Some((kind: OxygenatedAir, area_m2: 1.25)),
            builtin_intake: Some((kind: OxygenatedAir, area_m2: 1.5, efficiency: 1.0)),
            diameter: 2.0,
            thrust: 220000.0,
            isp: 3000.0,
            dry_mass: 1600.0,
            reactants: [
                (resource: Kerosene, mass_fraction: 1.0),
            ],
            power_draw_kw: 0.0,
        )),
        "gear_main_hd": Gear((
            display_name: "Heavy Main Landing Gear",
            strut_mass_per_m: 130.0,
            wheel_mass: 120.0,
            // Wide track (±1.0·host radius = the full fuselage half-width) so a
            // broad airliner resists tipping over its main gear, with a 2-wheel
            // tandem bogie per leg. (A belly-mounted axle much wider than the
            // hull would float off the skin; a true wing/sponson mount comes
            // with the morph work.)
            track_fraction: 1.0,
            default_strut_length: 1.9,
            default_wheel_radius: 0.6,
            wheels_per_leg: 2,
        )),
        "gear_nose_hd": Gear((
            display_name: "Heavy Nose Landing Gear",
            strut_mass_per_m: 110.0,
            wheel_mass: 90.0,
            track_fraction: 0.0,
            default_strut_length: 2.0,
            default_wheel_radius: 0.5,
        )),
    },
)
